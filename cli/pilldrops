def cmd_sandbox_checkpoint(args):
    """Named save points: save, list, rm, restore. Restore rolls the sandbox back in place."""
    base = f"/v1/sandboxes/{args.id}/checkpoints"
    if args.op == "list":
        d = api("get", base)
        if args.json:
            print(json.dumps(d, indent=2)); return
        cps = d.get("checkpoints", [])
        if not cps:
            print(f"  no checkpoints (max {d.get('max', '?')})"); return
        for c in cps:
            mb = (c.get("size_bytes") or 0) / (1024 * 1024)
            print(f"  {c['name']:<24} {c.get('snapshot_kind','?'):<7} {mb:8.1f} MiB  "
                  f"{c.get('status','?'):<9} {c.get('created_at','')}")
        print(f"  ({len(cps)} of {d.get('max','?')})")
        return
    if not args.name:
        print(f"{R}checkpoint {args.op} needs a name{N}"); sys.exit(1)
    if args.op == "save":
        d = api("post", base, {"name": args.name})
        if args.json:
            print(json.dumps(d, indent=2)); return
        mb = (d.get("size_bytes") or 0) / (1024 * 1024)
        print(f"{G}Saved {args.name}{N} on {args.id} — {d.get('snapshot_kind','?')}, {mb:.1f} MiB, "
              f"guest paused {d.get('paused_ms', 0)} ms")
        return
    if args.op == "rm":
        api("delete", f"{base}/{args.name}")
        print(f"{G}Removed {args.name}{N} from {args.id}")
        return
    # restore discards every write made since the checkpoint, so confirm unless -y.
    if not args.yes:
        ans = input(f"Roll {args.id} back to '{args.name}'? Writes since then are lost [y/N] ")
        if ans.strip().lower() not in ("y", "yes"):
            print("aborted"); return
    d = api("post", f"{base}/{args.name}/restore")
    if args.json:
        print(json.dumps(d, indent=2)); return
    print(f"{G}Restored {args.id} to {args.name}{N} in {d.get('restore_ms','?')} ms")


def cmd_snapshot(args):
    """Org-owned golden images: save, list, rm. A snapshot outlives the sandbox
    it came from and stamps out new ones with `sandbox create --from-snapshot`."""
    if args.op == "list":
        d = api("get", "/v1/snapshots")
        if args.json:
            print(json.dumps(d, indent=2)); return
        snaps = d.get("snapshots", [])
        if not snaps:
            print("  no snapshots"); return
        print(f"  {'NAME':<24} {'VER':<4} {'KIND':<7} {'STATUS':<9} {'SIZE':>10}  CREATED")
        for c in snaps:
            mb = (c.get("size") or 0) / (1024 * 1024)
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(c.get("created_at") or 0))
            print(f"  {c['name']:<24} {c.get('version','?'):<4} {c.get('snapshot_kind','?'):<7} "
                  f"{c.get('status','?'):<9} {mb:8.1f} MiB  {when}")
        return

    if args.op == "save":
        if not args.id or not args.name:
            print(f"{R}snapshot save needs a sandbox id and a name{N}"); sys.exit(1)
        d = api("post", f"/v1/sandboxes/{args.id}/snapshot", {"name": args.name})
        if args.json and not args.wait:
            print(json.dumps(d, indent=2)); return
        kind = d.get("snapshot_kind", "?")
        print(f"{G}Saving {args.name} v{d.get('version','?')}{N} from {args.id} — {kind}"
              + ("" if kind != "disk" else " (filesystem only: this runtime captures no memory)"))
        if not args.wait:
            print(f"  building; poll with `pilldrops snapshot list`")
            return
        # The memfile is the guest's whole RAM, so a save is asynchronous. --wait
        # hides that for a human; scripts should poll.
        build = d.get("build_id")
        for _ in range(600):
            got = api("get", f"/v1/snapshots/{args.name}")
            for v in got.get("versions", []):
                if v.get("build_id") == build and v.get("status") != "building":
                    if args.json:
                        print(json.dumps(v, indent=2)); return
                    if v.get("status") != "ready":
                        print(f"{R}Snapshot {args.name} failed{N}"); sys.exit(1)
                    mb = (v.get("size") or 0) / (1024 * 1024)
                    print(f"{G}Ready: {args.name} v{v.get('version')}{N} — {mb:.1f} MiB, "
                          f"{v.get('vcpu','?')} vCPU / {v.get('mem_mb','?')} MB")
                    return
            time.sleep(1)
        print(f"{R}Timed out waiting for {args.name}{N}"); sys.exit(1)

    # rm: every version goes, and the objects with them.
    if not args.name and args.id:
        args.name = args.id  # `snapshot rm <name>` reads more naturally than `rm - <name>`
    if not args.name:
        print(f"{R}snapshot rm needs a name{N}"); sys.exit(1)
    if not args.yes:
        ans = input(f"Delete every version of snapshot '{args.name}'? [y/N] ")
        if ans.strip().lower() not in ("y", "yes"):
            print("aborted"); return
    d = api("delete", f"/v1/snapshots/{args.name}")
    print(f"{G}Deleted {args.name}{N} — {d.get('deleted_versions','?')} version(s)")


