    frd = fs_sub.add_parser("read"); frd.add_argument("id"); frd.add_argument("path")

    # process
    pr = sub.add_parser("process", help="Process management")
    pr_sub = pr.add_subparsers(dest="action")
    pl = pr_sub.add_parser("list"); pl.add_argument("id")
    pk = pr_sub.add_parser("kill"); pk.add_argument("id"); pk.add_argument("pid", type=int)

    # template
