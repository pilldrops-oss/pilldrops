def _collect_files(root):
    """Read every text file under `root` into a [{path, content}] list (skips binaries)."""
    import glob
    files = []
    for path in sorted(glob.glob(os.path.join(root, "**", "*"), recursive=True)):
        if os.path.isfile(path):
            rel = os.path.relpath(path, root)
            try:
                with open(path, "r") as f:
                    files.append({"path": rel, "content": f.read()})
            except (UnicodeDecodeError, IsADirectoryError):
                pass  # skip binaries
    return files


def cmd_deploy(args):
    """Deploy a project directory in one call: upload files, run setup, start the app."""
    root = os.path.abspath(args.dir)
    if not os.path.isdir(root):
        print(f"{R}not a directory: {args.dir}{N}"); sys.exit(1)
    files = _collect_files(root)
    if not files:
        print(f"{R}no files found in {args.dir}{N}"); sys.exit(1)
    body = {"template": args.template, "files": files}
    if args.setup:
        body["setup"] = args.setup
    if args.start:
        body["start"] = args.start
    if args.port:
        body["port"] = args.port
    print(f"{M}Uploading {len(files)} file(s) to a {args.template} sandbox…{N}")
    d = api("post", "/v1/sandboxes", body, timeout=600)  # setup runs synchronously
    print(f"{G}Deployed{N}")
    print(f"  ID:      {C}{d['id']}{N}")
    for line in d.get("deploy_log", []):
        print(f"  {M}· {line}{N}")
    if d.get("app_url"):
        print(f"  App URL: {C}{d['app_url']}{N}")
        print(f"  {M}open it in a browser — your app is live.{N}")

