    sb_sub.add_parser("resume").add_argument("id")
    fk = sb_sub.add_parser("fork", help="copy a sandbox, memory and running processes included"); fk.add_argument("id"); fk.add_argument("--name", default=None); fk.add_argument("--timeout", type=int, default=None, help="child TTL in seconds (negative = persistent)"); fk.add_argument("--json", action="store_true")
    ck = sb_sub.add_parser("checkpoint", help="named save points you can roll a sandbox back to"); ck.add_argument("op", choices=["save", "list", "rm", "restore"]); ck.add_argument("id"); ck.add_argument("name", nargs="?", help="checkpoint name (not needed by list)"); ck.add_argument("-y", "--yes", action="store_true", help="skip the restore confirmation"); ck.add_argument("--json", action="store_true")
    sb_sub.add_parser("refresh").add_argument("id")
