# ─── AI-native deploy ────────────────────────────────────────────────────────

AI_SYSTEM = """You are a deployment agent for a Linux sandbox platform. Given a request, \
output a SINGLE JSON object describing how to build and run the app. The sandbox has the \
requested template (e.g. python-3.11) preinstalled with full internet access.

Respond with ONLY the JSON object — no prose, no markdown fences:
{
  "files":  [{"path": "app.py", "content": "...full file content..."}],
  "setup":  ["pip3 install -q flask"],
  "start":  "python3 app.py",
  "port":   8000,
  "description": "one short line"
}

Rules:
- The server MUST listen on host 0.0.0.0 and read its port from the PORT env var, \
falling back to the "port" you set (default 8000). e.g. port = int(os.environ.get("PORT", 8000)).
- Put every source file in "files" with complete content. Add a requirements file only if \
you also install it in "setup".
- "setup" runs once before start (installs, migrations); use quiet installs.
- "start" is one command that launches a long-running server bound to that port.
- Keep it minimal, self-contained, and handle errors gracefully."""

AI_FIX = """The previous deploy FAILED. Return a corrected JSON plan (same schema) that fixes \
the root cause. Respond with ONLY the JSON object.

Original request: {prompt}

Previous plan:
{plan}

Deploy log from the failed attempt:
{log}"""


def _extract_json(text):
    """Pull the first {...} JSON object out of a model response."""
    i, j = text.find("{"), text.rfind("}")
    if i == -1 or j == -1 or j < i:
        print(f"{R}model did not return JSON:{N}\n{text[:500]}", file=sys.stderr); sys.exit(1)
    try:
        return json.loads(text[i:j + 1])
    except json.JSONDecodeError as e:
        print(f"{R}could not parse model JSON: {e}{N}\n{text[:500]}", file=sys.stderr); sys.exit(1)


def _ai_client():
    """Build an Anthropic client. Two backends:
      • direct Anthropic — ANTHROPIC_API_KEY (default, api.anthropic.com)
      • an Anthropic-compatible gateway — set
        PILLDROPS_AI_BASE_URL to the gateway root WITHOUT a trailing /v1 (the SDK
        appends /v1/messages) and PILLDROPS_AI_TOKEN to the sk-gw-… virtual key.
    """
    try:
        import anthropic
    except ImportError:
        print(f"{R}`pilldrops ai` needs the anthropic package.{N} Install: pip3 install anthropic", file=sys.stderr)
        sys.exit(1)
    base = os.environ.get("PILLDROPS_AI_BASE_URL") or os.environ.get("E2B_AI_BASE_URL")
    token = os.environ.get("PILLDROPS_AI_TOKEN") or os.environ.get("E2B_AI_TOKEN") or os.environ.get("ANTHROPIC_AUTH_TOKEN")
    if base and token:
        return anthropic.Anthropic(auth_token=token, base_url=base)  # gateway: Bearer auth
    if os.environ.get("ANTHROPIC_API_KEY"):
        return anthropic.Anthropic()
    print(f"{R}No LLM backend configured for `pilldrops ai`.{N}", file=sys.stderr)
    print("  • direct: export ANTHROPIC_API_KEY=sk-ant-...", file=sys.stderr)
    print("  • gateway: export PILLDROPS_AI_BASE_URL=<root-without-/v1> PILLDROPS_AI_TOKEN=<key> "
          "PILLDROPS_AI_MODEL=<gateway-model>", file=sys.stderr)
    sys.exit(1)


def _ai_call(user, model):
    """Ask Claude for a deploy plan and return it as a dict."""
    client = _ai_client()
    msg = client.messages.create(
        model=model, max_tokens=8000, system=AI_SYSTEM,
        messages=[{"role": "user", "content": user}],
    )
    text = "".join(b.text for b in msg.content if getattr(b, "type", "") == "text")
    return _extract_json(text)


def _deploy_plan(plan, template):
    body = {"template": template}
    for k in ("files", "setup", "start", "port"):
        if plan.get(k):
            body[k] = plan[k]
    # Setup (apt/pip/compile) runs synchronously in the create call — allow ample time.
    return api("post", "/v1/sandboxes", body, timeout=600)


def _deploy_errors(plan, resp):
    """Scan a deploy response for failure signals (empty list == success)."""
    errs = []
    for line in resp.get("deploy_log", []) or []:
        if "exit=" in line or line.startswith("start:"):
            errs.append(line)
        elif line.startswith("setup '") and not line.endswith(" ok"):
            errs.append(line)
        elif line.startswith("write ") and ": " in line:
            errs.append(line)
    if plan.get("start") and not resp.get("app_url") and not errs:
        errs.append("server did not expose an app_url (start likely failed)")
    return errs


def cmd_ai(args):
    """Describe an app in English; Claude plans it, we deploy it, and self-heal on failure."""
    model = args.model or os.environ.get("PILLDROPS_AI_MODEL") or os.environ.get("E2B_AI_MODEL") or "claude-opus-4-8"
    print(f"{M}🤖 planning with {model}…{N}")
    plan = _ai_call(args.prompt, model)
    prev_id = None
    for attempt in range(args.retries + 1):
        if prev_id:  # tear down the previous failed attempt before retrying
            api("delete", f"/v1/sandboxes/{prev_id}", raw=True)
            prev_id = None
        if plan.get("description"):
            print(f"  {M}{plan['description']}{N}")
        for f in plan.get("files", []):
            print(f"  📄 wrote {C}{f['path']}{N}")
        resp = _deploy_plan(plan, args.template)
        sid = resp.get("id")
        for line in resp.get("deploy_log", []):
            print(f"  {M}· {line}{N}")
        errs = _deploy_errors(plan, resp)
        if not errs:
            print(f"{G}✅ deployed{N}  {C}{sid}{N}")
            if resp.get("app_url"):
                print(f"  App URL: {C}{resp['app_url']}{N}")
                print(f"  {M}open it in a browser — your app is live.{N}")
            else:
                print(f"  {M}sandbox {sid} is running (no web server started).{N}")
            return
        if args.no_heal or attempt == args.retries:
            print(f"{R}✗ deploy failed{N} — sandbox {C}{sid}{N} left running for inspection:", file=sys.stderr)
            for e in errs:
                print(f"    {R}{e}{N}", file=sys.stderr)
            print(f"  {M}logs: pilldrops sandbox logs {sid}{N}", file=sys.stderr)
            sys.exit(1)
        print(f"{O}🔄 fixing error ({attempt + 1}/{args.retries})…{N}")
        prev_id = sid
        plan = _ai_call(
            AI_FIX.format(prompt=args.prompt, plan=json.dumps(plan)[:4000],
                          log="\n".join(resp.get("deploy_log", []))),
            model,
        )


def main():
    p = argparse.ArgumentParser(prog="pilldrops", description="Sandbox Platform CLI")
    sub = p.add_subparsers(dest="group")

