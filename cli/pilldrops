    dp.add_argument("--setup", action="append", default=[], help="setup command (repeatable), e.g. 'pip install flask'")
    dp.add_argument("--port", type=int, default=8000, help="port the app serves ($PORT is injected)")

    # ai — natural-language build & deploy (needs ANTHROPIC_API_KEY)
    ai = sub.add_parser("ai", help="Describe an app in English; Claude builds & deploys it")
    ai.add_argument("prompt", help="what to build, e.g. 'a flask todo API'")
    ai.add_argument("--template", default="python-3.11")
    ai.add_argument("--model", default=None, help="Claude model (default claude-opus-4-8 / $PILLDROPS_AI_MODEL)")
    ai.add_argument("--retries", type=int, default=3, help="self-heal attempts on failure")
    ai.add_argument("--no-heal", action="store_true", help="don't auto-fix failures")

    args = p.parse_args()
    if not args.group: p.print_help(); return

    cmds = {
        ("sandbox","create"): cmd_sandbox_create, ("sandbox","list"): cmd_sandbox_list,
        ("sandbox","exec"): cmd_sandbox_exec, ("sandbox","destroy"): cmd_sandbox_destroy,
        ("sandbox","info"): cmd_sandbox_info, ("sandbox","pause"): cmd_sandbox_pause, ("sandbox","set-idle"): cmd_sandbox_set_idle, ("sandbox","set-hibernate"): cmd_sandbox_set_hibernate,
        ("sandbox","standby"): cmd_sandbox_standby, ("sandbox","resume"): cmd_sandbox_resume, ("sandbox","refresh"): cmd_sandbox_refresh, ("sandbox","fork"): cmd_sandbox_fork,
        ("sandbox","logs"): cmd_sandbox_logs, ("sandbox","metrics"): cmd_sandbox_metrics,
        ("sandbox","checkpoint"): cmd_sandbox_checkpoint,
        ("snapshot",None): cmd_snapshot, ("snap",None): cmd_snapshot,
        ("sandbox","expose"): cmd_sandbox_expose, ("sandbox","forwards"): cmd_sandbox_forwards,
