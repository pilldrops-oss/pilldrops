    si = sb_sub.add_parser("set-idle", help="change a live sandbox's idle standby timer"); si.add_argument("id"); si.add_argument("seconds", type=int, help="seconds (min 30; -1 = never; 0 = platform default)")
    sh = sb_sub.add_parser("set-hibernate", help="change a live sandbox's pause-to-disk timer"); sh.add_argument("id"); sh.add_argument("seconds", type=int, help="seconds (min 30; -1 = never; 0 = platform default)")
    sb_sub.add_parser("list")
    e = sb_sub.add_parser("exec"); e.add_argument("id"); e.add_argument("command"); e.add_argument("--timeout", type=int, default=30)
