    fwl = sb_sub.add_parser("forwards", help="list this sandbox's public endpoints"); fwl.add_argument("id"); fwl.add_argument("--json", action="store_true")
    ux = sb_sub.add_parser("unexpose", help="stop publishing a guest port and free its public port"); ux.add_argument("id"); ux.add_argument("port", type=int)
    sl = sb_sub.add_parser("logs"); sl.add_argument("id")
