        ("process","list"): cmd_process_list, ("process","kill"): cmd_process_kill,
        ("template","list"): cmd_template_list, ("template","create"): cmd_template_create,
        ("template","build"): cmd_template_build,
        ("build","list"): cmd_build_list,
        ("key","create"): cmd_key_create, ("key","list"): cmd_key_list,
        ("status",None): cmd_status,
        ("deploy",None): cmd_deploy,
        ("ai",None): cmd_ai,
    }
    fn = cmds.get((args.group, getattr(args, "action", None)))
    if fn: fn(args)
    else: p.parse_args([args.group, "-h"])

if __name__ == "__main__":
    main()
