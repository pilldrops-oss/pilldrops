#!/usr/bin/env python3
"""
pilldrops CLI — Command-line tool for the Sandbox Platform.

Usage:
  pilldrops ai "build a flask todo API"          # AI-native: describe it, Claude builds & deploys it
  pilldrops deploy ./myapp --start "python3 app.py" --port 8000
  pilldrops sandbox create [--template python-3.11] [--public]   # --public: shareable preview URL (default: private, token-gated)
  pilldrops sandbox list
  pilldrops sandbox exec <id> <command>
  pilldrops sandbox destroy <id>
  pilldrops sandbox info <id>
  pilldrops sandbox expose <id> 5432 [--tcp] [--udp]   # publish a guest port on a raw public endpoint
  pilldrops sandbox forwards <id> | unexpose <id> 5432
  pilldrops template list
  pilldrops template create <name> --dockerfile <path>
  pilldrops template build <id>
  pilldrops key create [--name my-key]
  pilldrops key list
  pilldrops status

Environment:
  PILLDROPS_API_URL   server base URL (default http://localhost:8080)
  PILLDROPS_API_KEY   bearer token for authenticated endpoints
  ANTHROPIC_API_KEY  required for `pilldrops ai`
  PILLDROPS_AI_MODEL  Claude model for `pilldrops ai` (default claude-opus-4-8)
"""
import argparse, json, os, sys, time, requests

BASE = os.environ.get("PILLDROPS_API_URL") or os.environ.get("E2B_API_URL") or "http://localhost:8080"
KEY = os.environ.get("PILLDROPS_API_KEY") or os.environ.get("E2B_API_KEY", "")

O = "\033[33m"; G = "\033[32m"; R = "\033[31m"; C = "\033[36m"; B = "\033[1m"; N = "\033[0m"; M = "\033[90m"

def api(method, path, data=None, raw=False, timeout=30):
    headers = {}
    if KEY: headers["Authorization"] = f"Bearer {KEY}"
    try:
        r = getattr(requests, method)(f"{BASE}{path}", json=data, headers=headers, timeout=timeout)
        if raw: return r
        if r.status_code == 204: return None
        if not r.ok:
            print(f"{R}Error {r.status_code}: {r.text}{N}", file=sys.stderr)
            sys.exit(1)
        return r.json()
    except requests.Timeout:
        # Deploys run setup (apt/pip/build) synchronously server-side; a slow one
        # can outlast the client timeout. Report it cleanly instead of a traceback.
        print(f"{R}Request timed out after {timeout}s: {method.upper()} {path}{N}", file=sys.stderr)
        print(f"{M}  If this was a deploy with heavy setup, raise the timeout or slim the setup steps.{N}", file=sys.stderr)
        sys.exit(1)
    except requests.ConnectionError:
        print(f"{R}Cannot connect to {BASE}. Is the server running?{N}", file=sys.stderr)
        print(f"Start with: make dev", file=sys.stderr)
        sys.exit(1)

def cmd_sandbox_create(args):
    body = {"timeout": args.timeout}
    if getattr(args, "from_snapshot", None):
        # The snapshot carries its own template, size and runtime; naming a
        # template as well is a 400, so the default one is not sent.
        body["snapshot"] = args.from_snapshot
    else:
        body["template"] = args.template
    if getattr(args, "public", False):
        body["public"] = True  # opt-in: preview URL reachable without a token
    if getattr(args, "idle_timeout", None) is not None:
        body["idle_timeout"] = args.idle_timeout  # seconds; -1 = never standby
    if getattr(args, "hibernate_timeout", None) is not None:
        body["hibernate_timeout"] = args.hibernate_timeout  # seconds; -1 = never hibernate
    d = api("post", "/v1/sandboxes", body)
    print(f"{G}Sandbox created{N}")
    print(f"  ID:       {C}{d['id']}{N}")
    print(f"  Template: {d.get('template','?')}")
    print(f"  Status:   {d.get('status','?')}")
    print(f"  Expires:  {d.get('expires_at','?')}")
    print(f"  idle_timeout: {d.get('idle_timeout','?')} (standby)")
    print(f"  hibernate_timeout: {d.get('hibernate_timeout','?')} (disk)")
    if d.get("boot_type"):
        woke = "woke from a memory image" if d["boot_type"] == "snapshot" else "cold boot"
        print(f"  Boot:     {d['boot_type']} ({woke}) in {d.get('boot_ms','?')} ms")
    if d.get("snapshot"):
        print(f"  Snapshot: {d['snapshot']} ({d.get('snapshot_kind','?')})")


