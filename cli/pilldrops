def cmd_sandbox_logs(args):
    # GET /v1/sandboxes/{id}/logs returns {"lines": [...], "note": "..."} — the
    # tail of the app log, plus an explanation when there isn't one.
    #
    # This used to iterate the response as a list of exec records and read
    # e['exit_code'] off each. Iterating a dict yields its KEYS, so every
    # invocation died with "'str' object has no attribute 'get'" — the command
    # was unusable for as long as the endpoint has had this shape.
    #
    # The note matters more than the lines when the list is empty: "no logs" and
    # "you never started a server, and exec output does not come through here"
    # send you to completely different places.
    resp = api("get", f"/v1/sandboxes/{args.id}/logs")
    if isinstance(resp, dict):
        lines, note = resp.get("lines") or [], resp.get("note", "")
    else:
        lines, note = (resp or []), ""
    for line in lines:
        print(f"  {line}" if isinstance(line, str) else f"  {line}")
    if not lines:
        print(f"{M}{note or 'No logs'}{N}")
    elif note:
        print(f"{M}{note}{N}")

