#!/usr/bin/env bash
# pdscan — security review of code you own, reported on the preview URL.
#
#   pdscan                          # scan ~/workspace: dependencies + secrets
#   pdscan /path/to/repo            # scan somewhere else
#   pdscan --url https://myapp.com  # also check that URL's response headers/TLS
#   pdscan --fail-on critical       # verdict threshold (default: high)
#
# What it runs:
#   osv-scanner   known-vulnerable dependencies (lockfiles/manifests)
#   gitleaks      secrets committed to the working tree or git history
#   headers       response headers + TLS of a URL you own (plain GETs only)
#
# Exit 0 = GREEN (nothing at or above the threshold), 1 = RED.
#
# There is no active vulnerability scanner here on purpose. Probing a host you
# don't own is an attack; check only your own targets.
set -uo pipefail

OUT=/root/security
TARGET="${HOME}/workspace"
URL=""
FAIL_ON=high

while [ $# -gt 0 ]; do
  case "$1" in
    --url) URL="$2"; shift 2 ;;
    --fail-on) FAIL_ON=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]'); shift 2 ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "pdscan: unknown flag $1" >&2; exit 2 ;;
    *) TARGET="$1"; shift ;;
  esac
done

case "$FAIL_ON" in
  low|medium|high|critical|never) ;;
  *) echo "pdscan: --fail-on must be low, medium, high, critical or never" >&2; exit 2 ;;
esac

mkdir -p "$OUT"
: > "$OUT/scan.log"
exec 3>&1
log() { printf '▸ %s\n' "$*" | tee -a "$OUT/scan.log" >&3; }

log "target:    $TARGET"
[ -n "$URL" ] && log "url:       $URL"
log "fail-on:   $FAIL_ON or worse"
log "scope:     your own code and targets only"
echo "" | tee -a "$OUT/scan.log" >&3

# ── dependencies ──────────────────────────────────────────────────────────────
DEPS_JSON="$OUT/dependencies.json"
if [ -d "$TARGET" ]; then
  log "scanning dependencies (osv-scanner)…"
  osv-scanner scan source --recursive --format json --output "$DEPS_JSON" "$TARGET" \
    >> "$OUT/scan.log" 2>&1
  osv_rc=$?
  # osv-scanner exits 1 when it finds vulnerabilities, 128 when it finds nothing
  # to scan. Neither is a failure of the run itself.
  case "$osv_rc" in
    0|1) : ;;
    *) log "osv-scanner: no supported manifest found (exit $osv_rc)"; echo '{}' > "$DEPS_JSON" ;;
  esac
else
  log "skipping dependency scan — $TARGET is not a directory"
  echo '{}' > "$DEPS_JSON"
fi

# ── secrets ───────────────────────────────────────────────────────────────────
SECRETS_JSON="$OUT/secrets.json"
if [ -d "$TARGET" ]; then
  log "scanning for committed secrets (gitleaks)…"
  # `dir` mode works with or without a .git directory; --no-banner keeps the log
  # readable. Exit 1 means leaks were found, which is a result, not an error.
  gitleaks dir "$TARGET" --report-format json --report-path "$SECRETS_JSON" \
    --no-banner --exit-code 1 >> "$OUT/scan.log" 2>&1
  [ -f "$SECRETS_JSON" ] || echo '[]' > "$SECRETS_JSON"
else
  echo '[]' > "$SECRETS_JSON"
fi

# ── url headers + TLS (passive: one GET) ──────────────────────────────────────
HEADERS_TXT="$OUT/headers.txt"
: > "$HEADERS_TXT"
if [ -n "$URL" ]; then
  log "checking response headers and TLS…"
  curl -sS -D "$HEADERS_TXT" -o /dev/null --max-time 20 \
       -w 'tls_version=%{ssl_verify_result}:%{http_version} http_code=%{http_code}\n' \
       "$URL" >> "$OUT/scan.log" 2>&1 || log "warning: could not fetch $URL"
fi

# ── report + verdict ──────────────────────────────────────────────────────────
pd-report "$OUT" "$FAIL_ON" "$TARGET" "$URL"
RC=$?
echo "" | tee -a "$OUT/scan.log" >&3
if [ "$RC" -eq 0 ]; then
  log "verdict: GREEN"
else
  log "verdict: RED"
fi
log "report on the preview port: index.html · dependencies.json · secrets.json · scan.log"
exit "$RC"
